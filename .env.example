# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / FRONTEND_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Supabase Credentials
# Connect to your Supabase project (Settings > API)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Optional Service Role Key for server-side administrative triggers if configured
SUPABASE_SERVICE_ROLE_KEY=""

# Frontend API base URL for split deployment (leave blank for same-origin dev)
VITE_API_BASE_URL=

